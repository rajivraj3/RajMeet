PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/rajmeet
JWT_SECRET=replace-with-a-long-random-secret

# Optional public browser endpoints for separately hosted client and API.
# Include /api in VITE_API_URL. Leave both blank for local Vite proxying.
VITE_API_URL=
VITE_SOCKET_URL=

# Server-only Xirsys credentials. Configure only on the API host (Render).
XIRSYS_IDENT=
XIRSYS_SECRET=
XIRSYS_CHANNEL=