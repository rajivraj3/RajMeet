PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/rajmeet
JWT_SECRET=replace-with-a-long-random-secret

# Optional public browser endpoints for separately hosted client and API.
# Include /api in VITE_API_URL. Leave both blank for local Vite proxying.
VITE_API_URL=
VITE_SOCKET_URL=

# Optional server-only coturn REST configuration for cross-network media.
# Configure these on the API host, never in Vercel or as VITE_* values.
TURN_URLS=
TURN_SHARED_SECRET=